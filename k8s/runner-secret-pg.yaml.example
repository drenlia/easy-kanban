# TEMPLATE ONLY — copy to the same path without .example and fill secrets.
# The non-.example file is gitignored so real values never enter the repo.
apiVersion: v1
kind: Secret
metadata:
  name: kanban-runner-secret
  namespace: easy-kanban-pg
  labels:
    app: kanban-runner
    database: postgresql
type: Opaque
stringData:
  # Shared bearer token for app ↔ runner. Replace before first apply (or let deploy script generate).
  # Must match RUNNER_TOKEN / AI_RUNNER_TOKEN on the easy-kanban Deployment.
  RUNNER_TOKEN: "RUNNER_TOKEN_PLACEHOLDER"
