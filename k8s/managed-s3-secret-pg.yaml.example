# TEMPLATE ONLY — copy to the same path without .example and fill secrets.
# The non-.example file is gitignored so real values never enter the repo.
apiVersion: v1
kind: Secret
metadata:
  name: easy-kanban-managed-s3
  namespace: easy-kanban-pg
  labels:
    app: easy-kanban
    database: postgresql
type: Opaque
stringData:
  # Platform-managed S3 credentials (SaaS). Seeded into each new tenant as
  # STORAGE_MANAGED=true + encrypted S3_SECRET_ACCESS_KEY (via SETTINGS_ENCRYPTION_KEY).
  # Leave placeholders empty to disable managed S3 seeding (MANAGED_S3_BUCKET in ConfigMap).
  # Replace before enabling managed object storage for tenants.
  MANAGED_S3_ACCESS_KEY_ID: "MANAGED_S3_ACCESS_KEY_ID_PLACEHOLDER"
  MANAGED_S3_SECRET_ACCESS_KEY: "MANAGED_S3_SECRET_ACCESS_KEY_PLACEHOLDER"
