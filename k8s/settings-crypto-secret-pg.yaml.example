# TEMPLATE ONLY — copy to the same path without .example and fill secrets.
# The non-.example file is gitignored so real values never enter the repo.
apiVersion: v1
kind: Secret
metadata:
  name: easy-kanban-settings-crypto
  namespace: easy-kanban-pg
  labels:
    app: easy-kanban
    database: postgresql
type: Opaque
stringData:
  # AES-256-GCM key material for admin settings at rest:
  # SMTP_PASSWORD, GOOGLE_CLIENT_SECRET, AI_API_KEY, AI_RUNNER_TOKEN,
  # and S3_SECRET_ACCESS_KEY (custom or platform-managed tenant S3).
  # Prefer a dedicated value (independent of JWT_SECRET).
  # On first create, deploy-pg.sh uses this file's value if set, else a random key.
  # If this Secret already has a real key, deploy-pg.sh leaves it unchanged.
  # Rotating this key requires re-entering encrypted secrets in Admin (or re-seed).
  SETTINGS_ENCRYPTION_KEY: "SETTINGS_ENCRYPTION_KEY_PLACEHOLDER"
